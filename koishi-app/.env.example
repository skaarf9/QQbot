# 复制成 .env 后填入你自己的真实值（.env 已被 .gitignore 排除，不会入库）
#
# 1) 模型 API key —— commandcode 中转（https://api.commandcode.ai/provider/v1）
#    koishi.yml 里所有 ChatLuna 平台都用 ${{ env.CC_API_KEY }} 引用它
CC_API_KEY=user_你的密钥

# 2) OneBot 适配器与 NapCat 握手用的 token（32 位随机串）
#    必须与 NapCat 侧 onebot11_<QQ号>.json → network.websocketServers[0].token 完全一致
NAPCAT_TOKEN=你的32位随机串
