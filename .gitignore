# ---- deps ----
node_modules/
package-lock.json.bak

# ---- runtime state (chat history db, file storage, caches) ----
koishi-app/data/
koishi-test/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- secrets ----
key.txt
*.secret
.env
.env.*
!.env.example
!.env.example.*

# ---- logs & temp ----
*.log
logs/
temp/
*.tmp

# ---- 测试台日志（跑一轮剧本 200~400 KB）----
#   策略：同名覆盖 + 跑完清扫超期日志，见 koishi-app/tools/log-retention.cjs
#       和 tools/clean-logs.cjs（默认保留 7 天，last-run.log / prod.log 永不删）
koishi-app/tools/logs/
koishi-app/tools/last-run.log

# ---- 文档切分前的原单文件备份（190 KB，确认分册没问题后可以删）----
进度与交接.md.bak-*

# ---- R12 自我扩展写配置前的备份（每次 /插件安装 都会生成一个，不入库）----
koishi-test/koishi.yml.bak-*
koishi-app/koishi.yml.bak-*

# ---- 本地嵌入模型的下载缓存（transformers.js / ONNX，约 23MB，可重下）----
models/

# ---- 调研/探针临时目录（抓下来的 registry、npm tarball 等）----
.scratch/

# ---- 一键启动面板的运行时状态（.runtime/panel：提权包装器、NapCat 控制台捕获、state.json）----
.runtime/

# ---- editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*

# ---- 一次性切分脚本的备份（2026-10-07 起）----
.doc-split-backup/

# ---- NapCat 运行时（QQ 框架本体，约 315 MB；新设备需单独安装，不入库）----
NapCat.Framework/
NapCat.Shell/

# ---- 本机试跑残留的配置备份 ----
koishi-app/.scratch-koishi.yml.bak
*.yml.bak

# ---- 模型清单 / 注册表抓取缓存（一次性，可重抓）----
ccmodels.json
ccmodels2.json
registry.json

# ---- 本地 AI 记忆目录（含本机绝对路径，不入库）----
.workbuddy/

# ---- 调研/探针的二进制与生成产物（源码脚本与文档仍入库）----
_research/*.tgz
_research/*.png
_research/testurl.txt
_research/imgrender/
_research/oai_like/
_research/pp/
_research/render-out/
