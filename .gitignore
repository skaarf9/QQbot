# ---- deps ----
node_modules/
package-lock.json.bak

# ---- runtime state (chat history db, file storage, caches) ----
koishi-app/data/
koishi-test/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- secrets ----
key.txt
*.secret
.env
.env.*

# ---- logs & temp ----
*.log
logs/
temp/
*.tmp

# ---- 测试台跑完留下的剧本回放（每次覆盖，不入库）----
koishi-app/tools/last-run.log

# ---- R12 自我扩展写配置前的备份（每次 /插件安装 都会生成一个，不入库）----
koishi-test/koishi.yml.bak-*
koishi-app/koishi.yml.bak-*

# ---- 本地嵌入模型的下载缓存（transformers.js / ONNX，约 23MB，可重下）----
models/

# ---- 调研/探针临时目录（抓下来的 registry、npm tarball 等）----
.scratch/

# ---- editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*
